# Copy this file to .env and fill in your keys
# cp .env.example .env

# OpenAI (required)
OPENAI_API_KEY=sk-...

# LangSmith (optional — auto-tracing enabled when set)
LANGSMITH_API_KEY=ls__...
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=shopsmart-support

# Langfuse (optional — callback tracing enabled when set)
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://us.cloud.langfuse.com
