# Copy this file to .env and fill in your keys
# cp .env.example .env

# OpenAI (required)
OPENAI_API_KEY=sk-...

# LangSmith (optional — auto-tracing enabled when set)
LANGSMITH_API_KEY=ls__...
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=shopsmart-support

# Langfuse (optional — callback tracing enabled when set)
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://us.cloud.langfuse.com

# --- Protocol Benchmark (Phase 1: REST, GraphQL, gRPC) ---
# All servers run as local subprocesses (make protocols-up)

REST_BASE_URL=http://127.0.0.1:8001
GRAPHQL_URL=http://127.0.0.1:8002/graphql
GRPC_PRICING_ADDR=127.0.0.1:8003

# Fault injection: none | timeout | error | malformed | refused
FAULT_MODE_REST=none
FAULT_MODE_GRAPHQL=none
FAULT_MODE_GRPC=none

REST_TIMEOUT_S=5
GRAPHQL_TIMEOUT_S=5
GRPC_TIMEOUT_S=5

REST_MAX_RETRIES=2
GRAPHQL_MAX_RETRIES=2
GRPC_MAX_RETRIES=2

# --- Protocol Benchmark (Phase 2: Webhook, WebSocket) ---
WEBHOOK_URL=http://127.0.0.1:8004/webhook/shipping-update
WS_TRACKING_URL=ws://127.0.0.1:8005/ws/tracking

FAULT_MODE_WEBHOOK=none
FAULT_MODE_WS=none

WEBHOOK_TIMEOUT_S=5
WS_TIMEOUT_S=5

WEBHOOK_MAX_RETRIES=2
WS_MAX_RETRIES=2

# --- Protocol Benchmark (Phase 3: MQTT, AMQP — requires `make brokers-up`) ---
MQTT_BROKER_HOST=127.0.0.1
MQTT_BROKER_PORT=1883
AMQP_URL=amqp://guest:guest@127.0.0.1:5672/

FAULT_MODE_MQTT=none
FAULT_MODE_AMQP=none

MQTT_TIMEOUT_S=5
AMQP_TIMEOUT_S=5

MQTT_MAX_RETRIES=2
AMQP_MAX_RETRIES=2

# --- Protocol Benchmark (Phase 4: SOAP legacy ERP stand-in) ---
SOAP_URL=http://127.0.0.1:8006/soap

FAULT_MODE_SOAP=none
SOAP_TIMEOUT_S=5
SOAP_MAX_RETRIES=2
